PORT=8080
BASE_URL=http://localhost:8080

DATABASE_URL=postgres://goshort:goshort@localhost:5432/goshort?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me

ADMIN_EMAIL=admin@goshort.dev
ADMIN_PASSWORD=goshort-demo

# 0 = ไม่ลงทะเบียน route ของ admin เลย ใช้กับ instance ที่รับ traffic สาธารณะ
ADMIN_ENABLED=1

# text = อ่านง่ายตอน dev, json = ให้ log aggregator ดูด
LOG_FORMAT=text

# ตั้งเมื่อโปรเซสนี้ทำหน้าที่คอนโซลอย่างเดียว ให้เกจอ่านตัวเลขของ instance ที่รับ redirect
# ไม่ตั้ง = อ่านของตัวเอง (ถูกแล้วสำหรับ instance เดียวที่ทำทั้งสองหน้าที่)
METRICS_SOURCE_URL=

CLICK_BUFFER_SIZE=1000
CLICK_WORKERS=8
CLICK_BATCH_SIZE=50
CLICK_FLUSH_INTERVAL=2s
SHUTDOWN_TIMEOUT=15s

CACHE_TTL=1h
AGGREGATE_CACHE_TTL=60s

# 1 = ข้าม Redis และเขียน click event แบบ synchronous ใช้วัด baseline ก่อน optimize
GOSHORT_SYNC_MODE=0

TRUST_PROXY=0

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
