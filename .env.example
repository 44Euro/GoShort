PORT=8080
BASE_URL=http://localhost:8080

DATABASE_URL=postgres://goshort:goshort@localhost:5432/goshort?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me

ADMIN_EMAIL=admin@goshort.dev
ADMIN_PASSWORD=goshort-demo

CLICK_BUFFER_SIZE=1000
CLICK_WORKERS=8
CLICK_BATCH_SIZE=50
CLICK_FLUSH_INTERVAL=2s
SHUTDOWN_TIMEOUT=15s

CACHE_TTL=1h
AGGREGATE_CACHE_TTL=60s

# 1 = ข้าม Redis และเขียน click event แบบ synchronous ใช้วัด baseline ก่อน optimize
GOSHORT_SYNC_MODE=0
GOSHORT_DEV=0
